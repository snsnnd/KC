[Unit]
# ================================================================
# 科创社 CMS — 内容管理 API 服务（systemd service）
# 功能：管理 Node.js Express 后端进程，提供社团管理 RESTful API。
# 部署路径: /etc/systemd/system/tech-club-cms.service
# 启动命令: systemctl enable --now tech-club-cms.service
# 部署文件路径: /opt/tech-club-cms
# ================================================================
Description=Tech Club Content Management API
# 网络就绪后再启动服务
After=network.target

[Service]
# Simple 类型：ExecStart 启动的进程是主进程（非 fork）
Type=simple
User=root
Group=root
# 安全注意：UMask 0077 确保创建的文件默认仅 root 可读写
UMask=0077
# 工作目录
WorkingDirectory=/opt/tech-club-cms
# 环境变量文件路径（含数据库密钥、SMTP 凭据等敏感信息）
# 安全注意：此文件权限必须为 600，属主 root:root
EnvironmentFile=/etc/tech-club-cms.env
# 启动命令
ExecStart=/usr/bin/node /opt/tech-club-cms/src/server.js
# 自动重启策略：非正常退出时自动重启
Restart=on-failure
# 重启等待时间（秒）
RestartSec=3
# 停止超时：SIGTERM 后最多等待 30 秒，超时则 SIGKILL
TimeoutStopSec=30s
# 状态目录 /var/lib/tech-club（systemd 自动创建）
StateDirectory=tech-club
StateDirectoryMode=0751
# 移除进程退出后的 IPC 对象（信号量、共享内存等）
RemoveIPC=true

# ================ 安全沙箱配置 ================
# 遵循最小权限原则，仅开放服务运行所需的最少能力。

# 禁止进程获取新的特权（禁用 setuid/setgid 二进制文件提权）
NoNewPrivileges=true
# 使用私有的 /tmp 和 /var/tmp（防止 /tmp 下的竞争攻击）
PrivateTmp=true
# 禁止访问物理设备（/dev）
PrivateDevices=true
# 严格保护系统目录：/usr、/etc 等只读，仅 ReadWritePaths 可写
ProtectSystem=strict
# 禁止访问 /home、/root 和 /run/user
ProtectHome=true
# 禁止修改主机名
ProtectHostname=true
# 禁止修改系统时钟
ProtectClock=true
# 禁止修改内核参数（sysctl）
ProtectKernelTunables=true
# 禁止加载/卸载内核模块
ProtectKernelModules=true
# 禁止访问内核日志（dmesg）
ProtectKernelLogs=true
# 禁止修改 cgroups 子系统
ProtectControlGroups=true
# 禁止创建命名空间（无法使用 unshare、clone 等）
RestrictNamespaces=true
# 禁止实时调度策略（SCHED_FIFO、SCHED_RR）
RestrictRealtime=true
# 禁止在文件上设置 SUID/SGID/能力位
RestrictSUIDSGID=true
# 锁定 personality（防止 32/64 位切换攻击）
LockPersonality=true
# 只允许执行本机 CPU 架构的系统调用
SystemCallArchitectures=native
# 允许的网络协议族：仅限 AF_UNIX（本地通信）AF_INET（IPv4）AF_INET6（IPv6）
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 允许写入的数据目录
ReadWritePaths=/var/lib/tech-club
# 清除所有 Linux capabilities（内核权限）
CapabilityBoundingSet=
AmbientCapabilities=

# ================ 资源限制 ================
# 最大任务数（线程数）
TasksMax=128
# 最大打开文件描述符数（生产模式需较高值以支持并发连接）
LimitNOFILE=16384
# 最大内存使用量（硬限制，超限则 OOM kill）
MemoryMax=512M
# CPU 配额：最多使用 2 核（200%）
CPUQuota=200%

[Install]
# 多用户运行级别自动启动
WantedBy=multi-user.target
