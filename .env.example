# ================================================================
# 科创社 CMS — 环境变量配置示例
# 复制本文件到 /etc/tech-club-cms.env 并按实际环境修改。
# 安全注意：本文件包含敏感凭据，必须设置 600 权限。
# systemd 可直接读取此文件；npm start 不会自动读取仓库根目录的 .env。
# ================================================================

# --- 必需（应用启动必须配置）---
# 管理员初始密码 —— 仅首次初始化 admin 账号时使用。
# 要求：至少 12 字符；初始化成功后必须立即从运行环境中移除本行。
ADMIN_PASSWORD=
# 会话加密密钥 —— 用于加密用户 Session 和对称加密数据。
# 要求：至少 32 字符；生产环境建议使用 ^[0-9a-fA-F]{64}$ 格式（64 位十六进制）。
# 生成命令: openssl rand -hex 32
SESSION_SECRET=
# 站点公开访问地址 —— 用于邮件通知中的跳转链接、CORS 校验等。
# 格式: https://your-domain.com （末尾不要加斜杠）
PUBLIC_BASE_URL=https://example.com
# Node.js 运行环境 —— 生产环境固定使用 production。
# 影响日志级别、错误处理行为和加密策略。
NODE_ENV=production
# 数据文件加密开关 —— 启用 AES-256-GCM 对存储的 JSON 数据文件加密。
# 生产环境必须设置为 true；开发调试时可设为 false 以查看明文数据。
DATA_ENCRYPTION=true

# --- 可选（使用默认值即可工作）---
# API 监听端口 —— Express 服务绑定端口（Nginx 反向代理到该端口）。
PORT=3000
# 数据文件存储目录 —— 存放 content.json、members.json 等持久化数据。
# 生产环境模板固定为 /var/lib/tech-club，不支持随意修改。
DATA_DIR=/var/lib/tech-club
# 上传文件存储目录 —— 存放媒体资源、项目文件等用户上传内容。
# 生产环境模板固定为 /var/lib/tech-club/uploads，不支持随意修改。
UPLOAD_DIR=/var/lib/tech-club/uploads
# 可信代理跳数 —— 客户端与 Node.js 之间只有本机 Nginx 一跳，因此设为 1。
# 安全注意：增加 CDN/LB 后必须按实际可信代理跳数调整此值。
# 设置不正确会导致 client IP 获取错误，影响审计日志和速率限制。
TRUST_PROXY_HOPS=1
# Secure Cookie —— HTTPS 环境下必须启用，防止 Cookie 被 HTTP 截获。
# 安全注意：如果 Nginx 在本地转发（HTTP），此值必须为 true（Nginx TLS 终止）。
COOKIE_SECURE=true
# 默认管理员邮箱 —— 当 content.json 未配置 managerEmail 时使用此值。
# 用于接收系统通知邮件（审批提醒、错误告警等）。
MANAGER_EMAIL=admin@example.com

# --- 邮件 SMTP（可选 — 不配置则不启用邮件通知功能）---
# SMTP 服务器地址 —— QQ 邮箱示例，请替换为实际 SMTP 服务器。
SMTP_HOST=smtp.qq.com
# SMTP 端口 —— 465（SSL/TLS）或 587（STARTTLS）。
# 安全注意：生产环境不应使用不加密的 25 端口。
SMTP_PORT=465
# SMTP 登录邮箱 —— 发件人地址。
SMTP_USER=your-email@qq.com
# SMTP 授权码 —— 不是邮箱登录密码。
# 安全注意：授权码具有发送邮件权限，应妥善保管，定期轮换。
SMTP_PASS=your-auth-code

# --- 过期时间配置 ---
# 邮件审批 Token 有效期 —— 单位小时，最大 72 小时（3 天）。
# 超时后审批链接失效，需重新发起审批流程。
EMAIL_APPROVAL_TTL_HOURS=24
# 成员激活码有效期 —— 单位小时，168 即 7 天，最大 720 小时（30 天）。
# 激活码过期后需管理员重新生成。
MEMBER_ACTIVATION_TTL_HOURS=168
