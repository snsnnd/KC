# Tech Club CMS 环境变量配置
# systemd 可将此模板整理为 /etc/tech-club-cms.env；npm start 不会自动读取仓库根目录的 .env。

# --- 必需 ---
# 仅首次初始化 admin 账号时使用，至少 12 字符；初始化成功后立即从运行环境中移除。
ADMIN_PASSWORD=
# 应用启动只校验至少 32 字符；生产部署要求匹配 ^[0-9a-fA-F]{64}$，可用 openssl rand -hex 32 生成。
SESSION_SECRET=
# 站点公开地址，用于邮件中的链接。
PUBLIC_BASE_URL=https://example.com
# 生产服务固定使用 production。
NODE_ENV=production
# 生产数据文件使用 AES-256-GCM 加密；生产模式必须为 true。
DATA_ENCRYPTION=true

# --- 可选 ---
# API 监听端口。
PORT=3000
# 生产模板固定路径，不支持随意修改。
DATA_DIR=/var/lib/tech-club
# 生产模板固定路径，不支持随意修改。
UPLOAD_DIR=/var/lib/tech-club/uploads
# 客户端与 Node.js 之间只有本机 Nginx 这一跳，因此明确设为 1；增加 CDN/LB 后必须按实际可信代理跳数调整。
TRUST_PROXY_HOPS=1
# HTTPS 环境必须启用 Secure Cookie。
COOKIE_SECURE=true
# 未配置 content.json 时使用的默认管理员邮箱。
MANAGER_EMAIL=admin@example.com

# --- 邮件 SMTP（可选）---
# SMTP 服务器地址。
SMTP_HOST=smtp.qq.com
# SMTP TLS 端口。
SMTP_PORT=465
# SMTP 登录邮箱。
SMTP_USER=your-email@qq.com
# SMTP 授权码，不是邮箱密码。
SMTP_PASS=your-auth-code

# --- 过期时间 ---
# 邮件审批 Token 有效期，单位小时，最大 72。
EMAIL_APPROVAL_TTL_HOURS=24
# 成员激活码有效期，单位小时，168 即 7 天，最大 720。
MEMBER_ACTIVATION_TTL_HOURS=168
